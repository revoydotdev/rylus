# Normalize line endings so the Windows CI runner doesn't churn LF↔CRLF.
* text=auto eol=lf

# Source: explicit LF
*.rs        text eol=lf
*.toml      text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.desktop   text eol=lf

# Windows tooling expects CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary
*.gif       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.icns      binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary

# Exclude generated and lock files from GitHub's "Languages" stats and PR diff noise.
Cargo.lock          linguist-generated=true
package-lock.json   linguist-generated=true
www/static/lib.js   linguist-generated=true
www/static/sw.js    linguist-generated=true
