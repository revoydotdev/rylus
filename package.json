{
  "private": true,
  "scripts": {
    "build": "esbuild ts/lib.ts --bundle --target=es2020 --minify --outfile=www/static/lib.js && esbuild ts/sw.ts --bundle --target=es2020 --minify --outfile=www/static/sw.js",
    "build:dev": "esbuild ts/lib.ts --bundle --target=es2020 --outfile=www/static/lib.js && esbuild ts/sw.ts --bundle --target=es2020 --outfile=www/static/sw.js",
    "watch": "esbuild ts/lib.ts --bundle --target=es2020 --outfile=www/static/lib.js --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.27.4",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  }
}
