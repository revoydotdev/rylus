# Maintainer: HMH <henry@freedesk.net>
pkgname=rylus
pkgver=0.17.0
pkgrel=1
pkgdesc="Turn your tablet into a graphic tablet / touch screen for your computer"
arch=('x86_64')
url="https://github.com/revelri/Rylus"
license=('AGPL-3.0-or-later')
depends=('pipewire' 'ffmpeg' 'gcc-libs' 'glibc')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf')
optdepends=('pipewire-pulse: PulseAudio compatibility')
provides=('rylus')
conflicts=('rylus-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/revelri/Rylus/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "Rylus-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
    npm ci || npm install
}

build() {
    cd "Rylus-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export CARGO_PROFILE_RELEASE_LTO=true
    cargo build --frozen --release --package rylus-server
}

check() {
    cd "Rylus-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --workspace
}

package() {
    cd "Rylus-$pkgver"

    install -Dm755 "target/release/rylus" "$pkgdir/usr/bin/rylus"
    install -Dm644 "packaging/rylus.desktop" \
        "$pkgdir/usr/share/applications/rylus.desktop"
    install -Dm644 "packaging/icons/rylus.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/rylus.svg"
    install -Dm644 "packaging/icons/rylus-256.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/rylus.png"
    install -Dm644 "packaging/systemd/rylus.service" \
        "$pkgdir/usr/lib/systemd/user/rylus.service"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Man page (generated by the binary itself via clap_mangen).
    install -d "$pkgdir/usr/share/man/man1"
    "$pkgdir/usr/bin/rylus" --print-man-page \
        > "$pkgdir/usr/share/man/man1/rylus.1"
    chmod 644 "$pkgdir/usr/share/man/man1/rylus.1"
}
