# Maintainer: HMH <henry@freedesk.net>
pkgname=rylus-bin
_pkgname=rylus
pkgver=0.17.0
pkgrel=1
pkgdesc="Turn your tablet into a graphic tablet (prebuilt binary)"
arch=('x86_64')
url="https://github.com/revelri/Rylus"
license=('AGPL-3.0-or-later')
depends=('pipewire' 'ffmpeg' 'gcc-libs' 'glibc')
provides=('rylus')
conflicts=('rylus')
source=(
    "$_pkgname-$pkgver.zip::https://github.com/revelri/Rylus/releases/download/v$pkgver/rylus-linux.zip"
    "https://raw.githubusercontent.com/revelri/Rylus/v$pkgver/packaging/rylus.desktop"
    "https://raw.githubusercontent.com/revelri/Rylus/v$pkgver/packaging/icons/rylus.svg"
    "https://raw.githubusercontent.com/revelri/Rylus/v$pkgver/packaging/icons/rylus-256.png"
    "https://raw.githubusercontent.com/revelri/Rylus/v$pkgver/packaging/systemd/rylus.service"
    "https://raw.githubusercontent.com/revelri/Rylus/v$pkgver/LICENSE"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/rylus" "$pkgdir/usr/bin/rylus"
    install -Dm644 "$srcdir/rylus.desktop" \
        "$pkgdir/usr/share/applications/rylus.desktop"
    install -Dm644 "$srcdir/rylus.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/rylus.svg"
    install -Dm644 "$srcdir/rylus-256.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/rylus.png"
    install -Dm644 "$srcdir/rylus.service" \
        "$pkgdir/usr/lib/systemd/user/rylus.service"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    install -d "$pkgdir/usr/share/man/man1"
    "$pkgdir/usr/bin/rylus" --print-man-page \
        > "$pkgdir/usr/share/man/man1/rylus.1"
    chmod 644 "$pkgdir/usr/share/man/man1/rylus.1"
}
